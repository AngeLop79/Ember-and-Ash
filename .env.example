POSTGRES_USER=ember
POSTGRES_PASSWORD=replace-with-a-local-password
POSTGRES_DB=ember_and_ash
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@localhost:5434/${POSTGRES_DB}
ADMIN_API_KEY=replace-with-a-long-random-secret

# Google OAuth web client. Add this exact redirect URI in Google Cloud Console.
GOOGLE_CLIENT_ID=310671425010-ac719249pteb8aate0sdphuiq1tlonnq.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Set to false to hide the reservation page, navigation link, and admin section.
NEXT_PUBLIC_RESERVATIONS_ENABLED=true

# Available order types; pickup is enabled by default.
NEXT_PUBLIC_ORDER_DELIVERY_ENABLED=false
NEXT_PUBLIC_ORDER_PICKUP_ENABLED=true
NEXT_PUBLIC_ORDER_DINE_IN_ENABLED=false

# Available payment methods; cash at pickup/delivery is enabled by default.
NEXT_PUBLIC_ORDER_PAYMENT_CASH_ENABLED=true
NEXT_PUBLIC_ORDER_PAYMENT_CARD_ENABLED=false
NEXT_PUBLIC_ORDER_PAYMENT_TRANSFER_ENABLED=false

# WhatsApp Business Platform: server-only values, no NEXT_PUBLIC_ prefix.
# Leave empty until the utility template and recipient opt-in are configured.
WHATSAPP_ORDER_NOTIFICATIONS_ENABLED=false
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=
WHATSAPP_ORDER_TEMPLATE=
WHATSAPP_TEMPLATE_LANGUAGE=it
# Version 2: short order code + protected order URL button.
# Existing installations can keep version 1 until the new template is approved.
# Version 3: sagra confirmation with customer_name, order_id and dynamic URL button.
WHATSAPP_ORDER_TEMPLATE_VERSION=2
WHATSAPP_TEMPLATE_PARAMETER_FORMAT=named
# Public HTTPS origin, matching the approved template button exactly.
APP_BASE_URL=https://your-project.vercel.app
